{
  "name": "data-room",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source investor data room — gated documents, viewer analytics, and an admin console.",
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack && bun scripts/check-public-chunks.ts",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "next": "16.2.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.8.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
