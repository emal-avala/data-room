# =============================================================================
# Data Room — environment
# Copy to .env.local for development. Set the same keys in the Vercel project.
# Docs: docs/deploy/environment-variables.md
# =============================================================================

# --- Company (replace these before you share the room) ---------------------
NEXT_PUBLIC_COMPANY_NAME="Example Co."
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Example Co., Inc."
NEXT_PUBLIC_COMPANY_DOMAIN="example.com"
NEXT_PUBLIC_COMPANY_TAGLINE="The institutional data room for your round."
NEXT_PUBLIC_ROUND_LABEL="Series A"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ACCENT="#1D4ED8"

# Immutable owner account. Must be a verified login. Not a database row.
SUPERADMIN_EMAIL="founder@example.com"

# Optional comma-separated allowlist that bypasses the waitlist.
# APPROVED_INVESTOR_EMAILS="partner@fund.example,analyst@fund.example"

# --- Supabase --------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Auth → URL configuration
#   Site URL:           https://your-data-room.vercel.app
#   Redirect URLs:      https://your-data-room.vercel.app/auth/callback
# Enable Google and/or Azure (Microsoft) providers.

# --- Email (optional — access requests + weekly digest) --------------------
# RESEND_API_KEY="re_..."
# IR_FROM_EMAIL="Example IR <noreply@ir.example.com>"
# IR_ADMIN_INBOX="founder@example.com"

# --- Cron / server-to-server ----------------------------------------------
# Required in production. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
# CRON_SECRET="generate-a-long-random-string"
